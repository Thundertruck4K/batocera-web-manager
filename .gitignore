# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Frontend React: el bundle compilado sí se versiona porque el dispositivo
# Batocera no tiene Node — se despliega tal cual. El código fuente y sus
# dependencias van en frontend/ con su propio .gitignore.
!frontend/dist/
!frontend/dist/**

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Project
static/
*.log

# Capturas crudas: material de trabajo del README (las figuras si van en docs/screenshots)
docs/_raw/

# Backups
*.bak
*.bak-*

# Scratch / herramienta temporal de desarrollo (no versionar)
.superpowers/
.diag/
_extracted.js
_jscheck.py
_peek.py
find_rom.py
_stage.py
_verify_history.py
_deploy.py
_probe*.sh
